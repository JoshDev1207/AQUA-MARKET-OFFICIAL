NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# SECRET. Server only. Use a secret key or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY
# Cloudinary Console > API Keys. SECRET values stay on the server.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# Set only if exactly one trusted reverse proxy sits in front of Node.
TRUST_PROXY=0
# Optional locally / single-instance hosting; REQUIRED on Vercel.
# Get a Redis TCP connection string; Vercel requires TLS (rediss://).
REDIS_URL=
# Optional. Defaults to a stable prefix derived from APP_URL.
REDIS_PREFIX=

# Groq Console > API Keys. Server only; optional for non-AI features.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

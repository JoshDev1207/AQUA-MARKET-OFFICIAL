# Import into Vercel Environment Variables, then replace every YOUR_ value.
NODE_ENV=production
AQUA_HOST=vercel
PORT=3000
APP_URL=https://YOUR_PRODUCTION_DOMAIN.vercel.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# Redis TCP/TLS URL, not UPSTASH_REDIS_REST_URL or a REST token.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379
# Keep this identical across production instances and redeployments.
# Use a different prefix and database for any preview/test environment.
REDIS_PREFIX=aquamarket:production
TRUST_PROXY=1

# Groq Console > API Keys. Server only; optional for non-AI features.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
